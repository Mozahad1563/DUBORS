<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Analytics Services -->
    <type name="BrainStation23\Dubors\Service\Analytics\KpiCalculator">
        <arguments>
            <argument name="resourceConnection" xsi:type="object">Magento\Framework\App\ResourceConnection</argument>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <type name="BrainStation23\Dubors\Service\Analytics\RevenueAttribution">
        <arguments>
            <argument name="resourceConnection" xsi:type="object">Magento\Framework\App\ResourceConnection</argument>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <type name="BrainStation23\Dubors\Service\Analytics\CustomerLifetimeValue">
        <arguments>
            <argument name="resourceConnection" xsi:type="object">Magento\Framework\App\ResourceConnection</argument>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <type name="BrainStation23\Dubors\Service\Analytics\RoiAnalysis">
        <arguments>
            <argument name="resourceConnection" xsi:type="object">Magento\Framework\App\ResourceConnection</argument>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <type name="BrainStation23\Dubors\Service\Analytics\ReportBuilder">
        <arguments>
            <argument name="resourceConnection" xsi:type="object">Magento\Framework\App\ResourceConnection</argument>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <!-- Admin Controllers -->
    <type name="BrainStation23\Dubors\Controller\Adminhtml\Analytics\Dashboard">
        <arguments>
            <argument name="context" xsi:type="object">Magento\Backend\App\Action\Context</argument>
            <argument name="resultPageFactory" xsi:type="object">Magento\Framework\View\Result\PageFactory</argument>
            <argument name="kpiCalculator" xsi:type="object">BrainStation23\Dubors\Service\Analytics\KpiCalculator</argument>
        </arguments>
    </type>

    <type name="BrainStation23\Dubors\Controller\Adminhtml\Reports\Generate">
        <arguments>
            <argument name="context" xsi:type="object">Magento\Backend\App\Action\Context</argument>
            <argument name="resultJsonFactory" xsi:type="object">Magento\Framework\Controller\Result\JsonFactory</argument>
            <argument name="reportBuilder" xsi:type="object">BrainStation23\Dubors\Service\Analytics\ReportBuilder</argument>
        </arguments>
    </type>

</config>
