<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <dubors>
            <general>
                <enabled>1</enabled>
                <tracking_enabled>1</tracking_enabled>
                <debug_mode>0</debug_mode>
            </general>

            <ml_service>
                <service_enabled>0</service_enabled>
                <service_url>http://localhost:5000</service_url>
                <service_timeout>30</service_timeout>
                <api_key></api_key>
            </ml_service>

            <recommendations>
                <min_confidence>75</min_confidence>
                <max_recommendations>5</max_recommendations>
                <validity_days>30</validity_days>
                <auto_approve>0</auto_approve>
            </recommendations>

            <advanced>
                <data_retention_days>365</data_retention_days>
                <batch_size>500</batch_size>
                <enable_export>1</enable_export>
            </advanced>

            <cron>
                <generate_recommendations_enabled>1</generate_recommendations_enabled>
                <purge_old_behavior_enabled>1</purge_old_behavior_enabled>
                <update_model_status_enabled>1</update_model_status_enabled>
                <monitor_ml_service_enabled>1</monitor_ml_service_enabled>
                <cleanup_logs_enabled>1</cleanup_logs_enabled>
            </cron>
        </dubors>
    </default>
</config>
