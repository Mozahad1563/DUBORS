<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Track product view event -->
    <event name="catalog_controller_product_view">
        <observer name="dubors_track_product_view" instance="BrainStation23\Dubors\Observer\TrackProductView" />
    </event>

    <!-- Track add to cart event -->
    <event name="checkout_cart_add_product_complete">
        <observer name="dubors_track_add_to_cart" instance="BrainStation23\Dubors\Observer\TrackAddToCart" />
    </event>

    <!-- Track order success event -->
    <event name="checkout_onepage_controller_success_action">
        <observer name="dubors_track_order_success" instance="BrainStation23\Dubors\Observer\TrackOrderSuccess" />
    </event>

    <!-- Track wishlist add event -->
    <event name="wishlist_add_product">
        <observer name="dubors_track_wishlist_add" instance="BrainStation23\Dubors\Observer\TrackWishlistAdd" />
    </event>

    <!-- Track search event -->
    <event name="catalogsearch_query_created">
        <observer name="dubors_track_search" instance="BrainStation23\Dubors\Observer\TrackSearch" />
    </event>

    <!-- Track DUBORS coupon redemption — sends conversion feedback to ML service -->
    <event name="sales_order_place_after">
        <observer name="dubors_track_coupon_redemption" instance="BrainStation23\Dubors\Observer\TrackCouponRedemption" />
    </event>
</config>
