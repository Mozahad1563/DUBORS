<script>
(function () {

/* ── Config injected from Magento ── */
const ML_BASE = '<?= $block->escapeJs($block->getMlServiceBaseUrl()) ?>';
const ML_WS   = '<?= $block->escapeJs($block->getMlServiceWsUrl()) ?>';

/* ── Chart.js defaults ── */
Chart.defaults.color = '#767676';
Chart.defaults.borderColor = '#e8e8e8';

/* ── State ── */
let recEvents      = [];
let feedbackEvents = [];
let retrainEvents  = [];
let throughputMap  = {};
let maeHistory     = [];
let importanceChart = null;

/* ── Chart: throughput ── */
const throughputChart = new Chart(document.getElementById('dbThroughput'), {
    type: 'line',
    data: { labels: [], datasets: [{ label: 'req/min', data: [], borderColor: '#1979c3', backgroundColor: 'rgba(25,121,195,0.08)', tension: 0.4, fill: true, pointRadius: 2 }] },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { grid: { color: '#eeeeee' } }, y: { grid: { color: '#eeeeee' }, beginAtZero: true, ticks: { precision: 0 } } }, animation: { duration: 300 } }
});

/* ── Chart: donut ── */
const donutChart = new Chart(document.getElementById('dbDonut'), {
    type: 'doughnut',
    data: {
        labels: ['0%','5%','8%','12%','15%','20%','25%','30%'],
        datasets: [{ data: [0,0,0,0,0,0,0,0], backgroundColor: ['#6c757d','#0dcaf0','#1979c3','#007600','#e07600','#fd7e14','#e22626','#6f42c1'], borderWidth: 2, borderColor: '#ffffff' }]
    },
    options: { responsive: true, cutout: '62%', plugins: { legend: { display: false } } }
});

/* ── Chart: gauge ── */
const gaugeChart = new Chart(document.getElementById('dbGauge'), {
    type: 'doughnut',
    data: { datasets: [{ data: [0, 100], backgroundColor: ['#007600', '#eeeeee'], borderWidth: 0, circumference: 180, rotation: 270 }] },
    options: { responsive: false, cutout: '75%', plugins: { legend: { display: false }, tooltip: { enabled: false } } }
});

/* ── Chart: reward ── */
const rewardChart = new Chart(document.getElementById('dbReward'), {
    type: 'bar',
    data: { labels: [], datasets: [
        { label: 'Reward', data: [], backgroundColor: [], borderRadius: 2 },
        { label: 'Avg',    data: [], type: 'line', borderColor: '#1979c3', borderWidth: 2, pointRadius: 0, tension: 0.4, fill: false }
    ]},
    options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { grid: { color: '#eeeeee' } } }, animation: { duration: 200 } }
});

/* ── Chart: MAE ── */
const maeChart = new Chart(document.getElementById('dbMaeChart'), {
    type: 'line',
    data: { labels: [], datasets: [{ label: 'MAE', data: [], borderColor: '#e07600', backgroundColor: 'rgba(224,118,0,0.08)', tension: 0.3, fill: true, pointRadius: 4 }] },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { grid: { color: '#eeeeee' }, beginAtZero: true } }, animation: { duration: 400 } }
});

/* ── WebSocket ── */
function connectWS() {
    const ws = new WebSocket(ML_WS);
    ws.onopen = () => {
        document.getElementById('dbWsDot').classList.add('live');
        document.getElementById('dbWsLabel').textContent = 'Live';
        dbLog('system', 'WebSocket connected to ' + ML_WS);
    };
    ws.onclose = () => {
        document.getElementById('dbWsDot').classList.remove('live');
        document.getElementById('dbWsLabel').textContent = 'Reconnecting…';
        setTimeout(connectWS, 3000);
    };
    ws.onerror = () => { document.getElementById('dbWsLabel').textContent = 'Error'; };
    ws.onmessage = (e) => {
        try { handleEvent(JSON.parse(e.data)); } catch(_) {}
    };
}

/* ── Event handler ── */
function handleEvent(ev) {
    const { event_type, timestamp, payload } = ev;
    dbLog(event_type, summarise(event_type, payload));

    if (event_type === 'recommendation') {
        recEvents.push({ timestamp, payload });
        if (recEvents.length > 500) recEvents.shift();
        addFeedRow(timestamp, payload);
        updateThroughput(timestamp);
        updateExplain(payload);
        document.getElementById('dbTotalRecs').textContent = recEvents.length;
        document.getElementById('dbFeedCount').textContent = recEvents.length + ' total';
        document.getElementById('dbToday').textContent = recEvents.length;
    }
    if (event_type === 'feedback') {
        feedbackEvents.push({ timestamp, payload });
        updateFeedbackMonitor();
        markFbCell(payload.recommendation_id, payload);
    }
    if (event_type === 'retrain_complete') {
        retrainEvents.push({ timestamp, payload });
        maeHistory.push(payload.mae);
        refreshMaeChart();
        fetchMetrics();
    }
    if (event_type === 'stage_change') {
        setStage(payload.to_stage);
    }
}

function summarise(type, p) {
    if (type === 'recommendation') return `cust=${p.customer_id} discount=${p.discount_percent}% conf=${p.confidence_score} type=${p.type}`;
    if (type === 'feedback') return `rec=…${(p.recommendation_id||'').slice(-8)} approved=${p.approved} reward=${p.reward}`;
    if (type === 'retrain_complete') return `${p.model_id} mae=${(p.mae||0).toFixed(3)} samples=${p.sample_count}`;
    if (type === 'stage_change') return `${p.from_stage} → ${p.to_stage}`;
    return JSON.stringify(p).substring(0, 80);
}

/* ── Feed table ── */
function addFeedRow(ts, p) {
    const tbody = document.getElementById('dbFeedBody');
    if (tbody.querySelector('td[colspan]')) tbody.innerHTML = '';
    const tr = document.createElement('tr');
    tr.id = 'dbrow-' + p.recommendation_id;
    tr.innerHTML = `
        <td style="color:var(--db-muted);white-space:nowrap">${ts.substring(11,19)}</td>
        <td><strong>${p.customer_id}</strong></td>
        <td style="font-family:monospace;color:var(--db-muted);font-size:10px">${(p.recommendation_id||'').slice(-10)}</td>
        <td><strong style="color:var(--db-green)">${p.discount_percent}%</strong></td>
        <td>${((p.confidence_score||0)*100).toFixed(0)}%</td>
        <td><span class="db-type-badge db-type-${p.type}">${p.type}</span></td>
        <td id="dbfb-${p.recommendation_id}" style="color:var(--db-muted)">—</td>
        <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--db-muted);font-size:11px" title="${(p.reason||'').replace(/"/g,"'")}">${p.reason||''}</td>
    `;
    tbody.insertBefore(tr, tbody.firstChild);
    while (tbody.children.length > 100) tbody.removeChild(tbody.lastChild);
}

function markFbCell(recId, p) {
    const cell = document.getElementById('dbfb-' + recId);
    if (!cell) return;
    if (p.approved && !p.corrected_discount) {
        cell.innerHTML = '<span style="color:var(--db-green);font-weight:600;">&#10003; Approved</span>';
    } else if (p.corrected_discount != null) {
        cell.innerHTML = `<span style="color:var(--db-yellow);font-weight:600;">&#9998; &rarr; ${p.corrected_discount}%</span>`;
    } else {
        cell.innerHTML = '<span style="color:var(--db-red);font-weight:600;">&#10007; Rejected</span>';
    }
}

/* ── Throughput ── */
function updateThroughput(ts) {
    const bucket = ts.substring(11, 16);
    throughputMap[bucket] = (throughputMap[bucket] || 0) + 1;
    const sorted = Object.entries(throughputMap).sort((a,b) => a[0].localeCompare(b[0])).slice(-20);
    throughputChart.data.labels = sorted.map(([k]) => k);
    throughputChart.data.datasets[0].data = sorted.map(([,v]) => v);
    throughputChart.update('none');
    document.getElementById('dbLastMin').textContent = sorted[sorted.length - 1]?.[1] || 0;
}

/* ── Feedback monitor ── */
function updateFeedbackMonitor() {
    const total    = feedbackEvents.length;
    const approved = feedbackEvents.filter(e => e.payload.approved).length;
    const rate     = total > 0 ? approved / total : 0;
    document.getElementById('dbTotalFb').textContent = total;
    document.getElementById('dbApproval').textContent = total > 0 ? `${(rate*100).toFixed(0)}%` : '—';
    document.getElementById('dbApprovalPct').textContent = total > 0 ? `${(rate*100).toFixed(0)}%` : '—';
    gaugeChart.data.datasets[0].data = [rate*100, 100-rate*100];
    gaugeChart.update('none');

    const rewards = feedbackEvents.slice(-50).map(e => e.payload.reward || 0);
    const rolling = rewards.map((_,i) => {
        const sl = rewards.slice(Math.max(0,i-9), i+1);
        return sl.reduce((a,b)=>a+b,0) / sl.length;
    });
    rewardChart.data.labels = rewards.map((_,i) => i+1);
    rewardChart.data.datasets[0].data = rewards;
    rewardChart.data.datasets[0].backgroundColor = rewards.map(r => r > 0 ? 'rgba(0,118,0,0.55)' : 'rgba(226,38,38,0.55)');
    rewardChart.data.datasets[1].data = rolling;
    rewardChart.update('none');
    const avg = rewards.length > 0 ? rewards.reduce((a,b)=>a+b,0)/rewards.length : null;
    document.getElementById('dbAvgReward').textContent = avg !== null ? avg.toFixed(3) : '—';
}

/* ── Explainability ── */
function updateExplain(p) {
    document.getElementById('dbExpCustomer').textContent = p.customer_id;
    document.getElementById('dbExpDiscount').textContent = `${p.discount_percent}%`;
    document.getElementById('dbExpConf').textContent     = `${((p.confidence_score||0)*100).toFixed(0)}%`;
    document.getElementById('dbExpType').textContent     = p.type;
    document.getElementById('dbExpReason').textContent   = p.reason || '—';
    renderShap(p.shap_top_features || {});
}

function renderShap(shap) {
    const el = document.getElementById('dbShapBars');
    el.innerHTML = '';
    const entries = Object.entries(shap);
    if (!entries.length) {
        el.innerHTML = '<div style="color:var(--db-muted);font-size:11px;">SHAP not available — rule_based stage or model untrained.</div>';
        return;
    }
    const maxAbs = Math.max(...entries.map(([,v]) => Math.abs(v)), 0.01);
    entries.sort((a,b) => Math.abs(b[1]) - Math.abs(a[1])).forEach(([feat, val]) => {
        const pct = Math.min((Math.abs(val) / maxAbs) * 100, 100);
        const pos = val >= 0;
        const row = document.createElement('div');
        row.className = 'db-shap-row';
        row.innerHTML = `
            <div class="db-shap-label">${feat.replace(/_/g,' ')}</div>
            <div class="db-shap-bar-wrap">
                <div class="db-shap-bar ${pos?'pos':'neg'}" style="width:${pct}%"></div>
            </div>
            <div class="db-shap-val" style="color:${pos?'var(--db-green)':'var(--db-red)'}">${val>0?'+':''}${val.toFixed(2)}</div>
        `;
        el.appendChild(row);
    });
}

/* ── Stage badge ── */
function setStage(stage) {
    ['dbStageBadge','dbStageBadge2'].forEach(id => {
        const el = document.getElementById(id);
        el.className = `db-stage db-stage-${stage}`;
        el.textContent = stage;
    });
}

/* ── MAE chart ── */
function refreshMaeChart() {
    maeChart.data.labels = maeHistory.map((_,i) => `v${i+1}`);
    maeChart.data.datasets[0].data = maeHistory;
    maeChart.update();
    const last = maeHistory[maeHistory.length-1];
    document.getElementById('dbMae').textContent = last !== undefined ? last.toFixed(3) : '—';
    const dots = document.getElementById('dbMaeDots');
    dots.innerHTML = maeHistory.slice(-8).map((m,i) => `<span class="db-mae-dot">v${i+1}: ${m.toFixed(2)}</span>`).join('');
}

/* ── Metrics poll ── */
function fetchMetrics() {
    fetch(ML_BASE + '/metrics')
        .then(r => r.ok ? r.json() : null)
        .then(m => {
            if (!m) return;
            setStage(m.stage || 'rule_based');
            document.getElementById('dbModelId').textContent = 'model: ' + (m.model_id || '—');
            document.getElementById('dbLastTrained').textContent = m.last_trained ? 'Last trained: ' + m.last_trained.substring(0,19) : 'Never trained';
            document.getElementById('dbSamples').textContent = m.sample_count || 0;
            document.getElementById('dbTotalFb').textContent = m.total_feedback || 0;
            document.getElementById('dbFbPending').textContent = `${m.feedback_since_last_train||0}/10`;
            if (m.total_recommendations > recEvents.length) document.getElementById('dbTotalRecs').textContent = m.total_recommendations;
            if (m.approval_rate != null) {
                document.getElementById('dbApproval').textContent = `${(m.approval_rate*100).toFixed(0)}%`;
                document.getElementById('dbApprovalPct').textContent = `${(m.approval_rate*100).toFixed(0)}%`;
                gaugeChart.data.datasets[0].data = [m.approval_rate*100, 100-m.approval_rate*100];
                gaugeChart.update('none');
            }
            if (m.mae) {
                document.getElementById('dbMae').textContent = m.mae.toFixed(3);
                if (!maeHistory.includes(m.mae)) { maeHistory.push(m.mae); refreshMaeChart(); }
            }

            /* Stage progress */
            const stage = m.stage || 'rule_based';
            const prog  = document.getElementById('dbProgressSection');
            const lbl   = document.getElementById('dbProgressLabel');
            const bar   = document.getElementById('dbProgressBar');
            if (stage === 'rule_based') {
                const pct = Math.min(((m.sample_count||0)/50)*100,100);
                lbl.textContent = `Progress to supervised: ${m.sample_count||0} / 50 samples`;
                bar.style.width = pct + '%'; prog.style.display='block';
            } else if (stage === 'supervised') {
                const pct = Math.min(((m.total_feedback||0)/20)*100,100);
                lbl.textContent = `Progress to RL policy: ${m.total_feedback||0} / 20 feedback entries`;
                bar.style.width = pct + '%'; prog.style.display='block';
            } else { prog.style.display='none'; }

            document.getElementById('dbSampleSub').textContent =
                stage === 'rule_based' ? `${50-(m.sample_count||0)} more to train` :
                stage === 'supervised' ? 'model active' : 'RL policy active';

            /* Donut */
            if (m.tier_distribution && m.tier_distribution.length) {
                donutChart.data.datasets[0].data = m.tier_distribution.map(t => t.count);
                donutChart.update('none');
                const total = m.tier_distribution.reduce((a,t)=>a+t.count,0);
                const colours = ['#6c757d','#0dcaf0','#1979c3','#007600','#e07600','#fd7e14','#e22626','#6f42c1'];
                document.getElementById('dbDonutLegend').innerHTML = m.tier_distribution.map((t,i) => `
                    <div class="db-legend-row">
                        <div class="db-legend-dot" style="background:${colours[i]}"></div>
                        <span style="color:var(--db-muted)">${t.tier_label}</span>
                        <span style="margin-left:auto;font-weight:600">${t.count}</span>
                        <span style="color:var(--db-muted);width:32px;text-align:right">${total>0?((t.count/total)*100).toFixed(0):0}%</span>
                    </div>
                `).join('');
            }

            /* Feature importance */
            if (m.global_feature_importance) {
                document.getElementById('dbImpEmpty').style.display='none';
                document.getElementById('dbImpSection').style.display='block';
                const sorted = Object.entries(m.global_feature_importance).sort((a,b)=>b[1]-a[1]);
                const maxV = Math.max(...sorted.map(([,v])=>v), 0.01);
                if (!importanceChart) {
                    importanceChart = new Chart(document.getElementById('dbImportance'), {
                        type: 'bar',
                        data: {
                            labels: sorted.map(([k])=>k.replace(/_/g,' ')),
                            datasets: [{ label: 'Mean |SHAP|', data: sorted.map(([,v])=>v), backgroundColor: sorted.map(([,v])=>`rgba(25,121,195,${0.3+0.7*(v/maxV)})`), borderRadius: 2 }]
                        },
                        options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } }, scales: { x: { grid: { color: '#eeeeee' } }, y: { grid: { display: false } } } }
                    });
                } else {
                    importanceChart.data.labels = sorted.map(([k])=>k.replace(/_/g,' '));
                    importanceChart.data.datasets[0].data = sorted.map(([,v])=>v);
                    importanceChart.data.datasets[0].backgroundColor = sorted.map(([,v])=>`rgba(25,121,195,${0.3+0.7*(v/maxV)})`);
                    importanceChart.update();
                }
            }
        })
        .catch(() => {});
}

/* ── Event log ── */
function dbLog(type, msg) {
    const log  = document.getElementById('dbLog');
    const time = new Date().toISOString().substring(11,19);
    const entry = document.createElement('div');
    entry.className = 'db-log-entry';
    entry.innerHTML = `<span class="db-log-time">${time}</span><span class="db-log-type ${type}">${type}</span><span class="db-log-payload">${msg}</span>`;
    log.insertBefore(entry, log.firstChild);
    while (log.children.length > 100) log.removeChild(log.lastChild);
}

function dbClearLog() { document.getElementById('dbLog').innerHTML = ''; }

/* ── Boot ── */
connectWS();
fetchMetrics();
setInterval(fetchMetrics, 5000);

})();
</script>
