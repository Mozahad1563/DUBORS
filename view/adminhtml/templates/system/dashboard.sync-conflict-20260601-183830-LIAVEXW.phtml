<script>
require(['jquery'], function($) {
    // Performance Chart
    const ctx = document.getElementById('performanceChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
            datasets: [{
                label: 'Prediction Accuracy (%)',
                data: [75, 78, 80, 79, 82, 81, 82],
                borderColor: '#007bdb',
                tension: 0.1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: false,
                    min: 50,
                    max: 100
                }
            }
        }
    });

    $('#refresh-health').click(function() {
        $.ajax({
            url: '<?= $block->getHealthCheckUrl() ?>',
            type: 'GET',
            showLoader: true,
            success: function(response) {
                location.reload();
            }
        });
    });
});
</script>

